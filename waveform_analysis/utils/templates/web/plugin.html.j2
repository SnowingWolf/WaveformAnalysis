{% extends "web/base.html.j2" %}
{% set page_title = plugin.provides ~ " | WaveformAnalysis" %}
{% set body_class = "docs-page docs-detail" %}
{% set layout_class = "doc-layout" %}
{% set current = "plugins" %}
{% set accessor_detail_prefix = "../accessors/" %}
{% block document %}
<main class="reference docs-main"><nav class="breadcrumbs" aria-label="面包屑"><a href="{{ site_home_href }}">文档概览</a><a href="{{ plugin_index_href }}">插件参考</a><span aria-current="page">{{ plugin.provides }}</span></nav><header class="page-heading"><p class="eyebrow">{{ plugin.category_display }}</p><h1>{{ plugin.provides }}</h1><p>{{ (plugin.description or "暂无说明。") | inline_code }}</p></header>
{% if lineage_graph %}{% include "web/lineage_graph.html.j2" %}{% endif %}
<section id="overview"><h2>概览</h2>{% if plugin.overview_paragraphs %}<div class="plugin-overview">{% for p in plugin.overview_paragraphs %}<p>{{ p | inline_code }}</p>{% endfor %}</div>{% elif plugin.overview %}<div class="plugin-overview"><p>{{ plugin.overview | inline_code }}</p></div>{% endif %}<table><thead><tr><th>项目</th><th>值</th></tr></thead><tbody><tr><td>插件类</td><td><code>{{ plugin.name }}</code></td></tr><tr><td>模块</td><td><code>{{ plugin.module_path }}</code></td></tr><tr><td>版本</td><td><code>{{ plugin.version }}</code></td></tr><tr><td>输出容器</td><td><code>{{ plugin.output_kind }}</code></td></tr><tr><td>执行模式</td><td><code>{{ plugin.execution_kind }}</code></td></tr><tr><td>保存策略</td><td><code>{{ plugin.save_when }}</code></td></tr><tr><td>运行配置</td><td><code>{{ "yes" if plugin.uses_run_config else "no" }}</code></td></tr><tr><td>超时</td><td><code>{{ plugin.timeout if plugin.timeout is not none else "none" }}</code></td></tr><tr><td>副作用</td><td><code>{{ "yes" if plugin.is_side_effect else "no" }}</code></td></tr><tr><td>叙述来源</td><td><code>{{ plugin.documentation_status.source if plugin.documentation_status else "unknown" }}</code></td></tr><tr><td>源码 fingerprint</td><td><code>{{ plugin.source_fingerprint or "unavailable" }}</code></td></tr></tbody></table><h3>依赖</h3><p>默认画像：<code>{{ plugin.dependency_profile }}</code>{% if plugin.dependency_profile_values %}（{{ plugin.dependency_profile_values }}）{% endif %}。</p>{% if plugin.has_dynamic_dependencies %}<p>动态依赖配置键：{% if plugin.dependency_config_keys %}{% for key in plugin.dependency_config_keys %}<code>{{ key }}</code>{% if not loop.last %}、{% endif %}{% endfor %}{% else %}源码未声明可静态提取的配置键{% endif %}。</p>{% endif %}<table><thead><tr><th>依赖</th><th>版本约束</th><th>解析方式</th><th>必需字段</th><th>说明</th></tr></thead><tbody>{% if plugin.resolved_dependency_details %}{% for dep in plugin.resolved_dependency_details %}<tr><td><code>{{ dep.name }}</code></td><td>{{ dep.version_constraint or "-" }}</td><td>{{ dep.resolution }}</td><td>{{ dep.required_fields|join(", ") or "-" }}</td><td>{{ (dep.description or "暂无生产者说明。") | inline_code }}</td></tr>{% endfor %}{% else %}<tr><td colspan="5">没有声明输入。</td></tr>{% endif %}</tbody></table><h3>工作方式</h3><ol class="workflow">{% for step in plugin.workflow_steps %}<li>{{ step | inline_code }}</li>{% endfor %}</ol>{% if plugin.workflow_diagram %}<h3>处理流程图</h3><div class="mermaid-block mermaid-block--plugin" data-mermaid-block><pre class="mermaid-source"><code>{{ plugin.workflow_diagram | e }}</code></pre><div class="mermaid-render" data-mermaid-render aria-label="Mermaid 流程图"></div><p class="mermaid-error" data-mermaid-error hidden>流程图渲染失败，已保留 Mermaid 源码。</p></div>{% endif %}</section>
<section id="configuration"><h2>配置</h2><table><thead><tr><th>名称</th><th>类型</th><th>默认值</th><th>单位</th><th>跟踪</th><th>弃用</th><th>说明</th></tr></thead><tbody>{% if plugin.config_options %}{% for opt in plugin.config_options %}<tr><td><code>{{ opt.name }}</code></td><td><code>{{ opt.type }}</code></td><td><code>{{ opt.default }}</code></td><td>{{ opt.units or "-" }}</td><td>{{ "是" if opt.tracked else "否" }}</td><td>{{ "是" if opt.deprecated else "否" }}</td><td>{{ (plugin.config_notes.get(opt.name, opt.doc or "暂无说明。")) | inline_code }}</td></tr>{% endfor %}{% else %}<tr><td colspan="7">此插件没有插件级配置。</td></tr>{% endif %}</tbody></table></section>
<section id="output"><h2>输出</h2><p>{{ plugin.output_summary | inline_code }}</p><table><thead><tr><th>字段</th><th>DType</th><th>单位</th><th>含义</th></tr></thead><tbody>{% if plugin.output_fields %}{% for field in plugin.output_fields %}<tr><td><code>{{ field.name }}</code></td><td><code>{{ field.dtype }}</code></td><td>{{ field.units or "-" }}</td><td>{{ (field.doc or plugin.field_notes.get(field.name, "暂无字段说明。")) | inline_code }}</td></tr>{% endfor %}{% else %}<tr><td>容器</td><td><code>{{ plugin.output_kind }}</code></td><td>-</td><td>{{ plugin.output_summary | inline_code }}</td></tr>{% endif %}</tbody></table></section>
<section id="usage"><h2>使用</h2><h3>最小示例</h3>{% if plugin.usage_example %}<pre class="code-block language-python"><code>{{ plugin.usage_example | highlight_python }}</code></pre>{% else %}<pre class="code-block language-python"><code>{{ ("from waveform_analysis.core.context import Context\nfrom waveform_analysis.core.plugins.builtin.cpu import " ~ plugin.name ~ "\n\nctx = Context(config={\"data_root\": \"DAQ\"})\nctx.register(" ~ plugin.name ~ "())\ndata = ctx.get_data(\"run_001\", \"" ~ plugin.provides ~ "\")") | highlight_python }}</code></pre>{% endif %}<h3>行为与运行影响</h3><ul>{% for note in plugin.behavior_notes %}<li>{{ note | inline_code }}</li>{% endfor %}{% for note in plugin.execution_notes %}<li>{{ note | inline_code }}</li>{% endfor %}</ul>{% if plugin.failure_modes %}<h4>失败模式</h4><ul>{% for mode in plugin.failure_modes %}<li>{{ mode | inline_code }}</li>{% endfor %}{% endif %}<h4>下游消费者</h4>{% if plugin.downstream_consumers %}<ul>{% for consumer in plugin.downstream_consumers %}<li><code>{{ consumer }}</code></li>{% endfor %}</ul>{% else %}<p>终端输出，没有声明直接的内置消费者。</p>{% endif %}</section></main>
{% endblock %}
