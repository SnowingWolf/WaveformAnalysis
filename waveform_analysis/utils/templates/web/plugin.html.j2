<!doctype html>
<html lang="zh-CN">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ plugin.provides }} | WaveformAnalysis</title>
  <link rel="stylesheet" href="{{ asset_prefix }}site.css"><script defer src="{{ asset_prefix }}site.js"></script>
</head>
<body>
  <nav class="site-nav" aria-label="主导航"><a href="{{ site_home_href }}" class="site-brand">WaveformAnalysis 文档</a><a href="{{ plugin_index_href }}" aria-current="page">插件系统</a>{% if accessor_index_href %}<a href="{{ accessor_index_href }}">Accessor</a>{% endif %}</nav>
  <header class="plugin-header"><a href="{{ plugin_index_href }}" class="back-link">返回插件索引</a><p class="eyebrow">{{ plugin.category_display }}</p><h1>{{ plugin.provides }}</h1><p class="lede">{{ plugin.description or "暂无说明。" }}</p></header>
  <main class="reference">
    {% if lineage_graph %}{% include "web/lineage_graph.html.j2" %}{% endif %}
    <section><h2>概览</h2>
      {% if plugin.overview_paragraphs %}<div class="plugin-overview">{% for p in plugin.overview_paragraphs %}<p>{{ p }}</p>{% endfor %}</div>{% elif plugin.overview %}<div class="plugin-overview"><p>{{ plugin.overview }}</p></div>{% endif %}
      <table><thead><tr><th>项目</th><th>值</th></tr></thead><tbody><tr><td>插件类</td><td><code>{{ plugin.name }}</code></td></tr><tr><td>模块</td><td><code>{{ plugin.module_path }}</code></td></tr><tr><td>版本</td><td><code>{{ plugin.version }}</code></td></tr><tr><td>输出类型</td><td><code>{{ plugin.output_kind }}</code></td></tr></tbody></table>
      <h3>依赖</h3><table><thead><tr><th>依赖</th><th>版本约束</th><th>解析方式</th><th>必需字段</th><th>说明</th></tr></thead><tbody>
      {% if plugin.dependency_details %}{% for dep in plugin.dependency_details %}<tr><td><code>{{ dep.name }}</code></td><td>{{ dep.version_constraint or "-" }}</td><td>{{ dep.resolution }}</td><td>{{ dep.required_fields|join(", ") or "-" }}</td><td>{{ dep.description or "暂无生产者说明。" }}</td></tr>{% endfor %}{% else %}<tr><td colspan="5">没有声明输入。</td></tr>{% endif %}</tbody></table>
      <h3>工作方式</h3><ol class="workflow">{% for step in plugin.workflow_steps %}<li>{{ step }}</li>{% endfor %}</ol>
    </section>
    <section><h2>配置</h2><table><thead><tr><th>名称</th><th>类型</th><th>默认值</th><th>单位</th><th>跟踪</th><th>弃用</th><th>说明</th></tr></thead><tbody>
      {% if plugin.config_options %}{% for opt in plugin.config_options %}<tr><td><code>{{ opt.name }}</code></td><td><code>{{ opt.type }}</code></td><td><code>{{ opt.default }}</code></td><td>{{ opt.units or "-" }}</td><td>{{ "是" if opt.tracked else "否" }}</td><td>{{ "是" if opt.deprecated else "否" }}</td><td>{{ plugin.config_notes.get(opt.name, opt.doc or "暂无说明。") }}</td></tr>{% endfor %}{% else %}<tr><td colspan="7">此插件没有插件级配置。</td></tr>{% endif %}</tbody></table></section>
    <section><h2>输出</h2><p>{{ plugin.output_summary }}</p><table><thead><tr><th>字段</th><th>DType</th><th>单位</th><th>含义</th></tr></thead><tbody>
      {% if plugin.output_fields %}{% for field in plugin.output_fields %}<tr><td><code>{{ field.name }}</code></td><td><code>{{ field.dtype }}</code></td><td>{{ field.units or "-" }}</td><td>{{ field.doc or plugin.field_notes.get(field.name, "暂无字段说明。") }}</td></tr>{% endfor %}{% else %}<tr><td>容器</td><td><code>{{ plugin.output_kind }}</code></td><td>-</td><td>{{ plugin.output_summary }}</td></tr>{% endif %}</tbody></table></section>
    <section><h2>使用</h2><h3>最小示例</h3><pre><code>{% if plugin.usage_example %}{{ plugin.usage_example }}{% else %}from waveform_analysis.core.context import Context
from waveform_analysis.core.plugins.builtin.cpu import {{ plugin.name }}

ctx = Context(config={"data_root": "DAQ"})
ctx.register({{ plugin.name }}())
data = ctx.get_data("run_001", "{{ plugin.provides }}"){% endif %}</code></pre>
      <h3>行为与运行影响</h3><ul>{% for note in plugin.behavior_notes %}<li>{{ note }}</li>{% endfor %}{% for note in plugin.execution_notes %}<li>{{ note }}</li>{% endfor %}</ul>
      {% if plugin.failure_modes %}<h4>失败模式</h4><ul>{% for mode in plugin.failure_modes %}<li>{{ mode }}</li>{% endfor %}</ul>{% endif %}<h4>下游消费者</h4>
      {% if plugin.downstream_consumers %}<ul>{% for consumer in plugin.downstream_consumers %}<li><code>{{ consumer }}</code></li>{% endfor %}</ul>{% else %}<p>终端输出，没有声明直接的内置消费者。</p>{% endif %}
    </section>
  </main>
</body></html>
