<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ plugin.provides }} | WaveformAnalysis</title>
  <link rel="stylesheet" href="../assets/site.css">
</head>
<body>
  <header class="plugin-header">
    <a href="../index.html" class="back-link">Plugin index</a>
    <p class="eyebrow">{{ plugin.category_display }}</p>
    <h1>{{ plugin.provides }}</h1>
    <p class="lede">{{ plugin.description or "No description available." }}</p>
  </header>
  <main class="reference">
    <section><h2>Overview</h2>
      <table><thead><tr><th>Item</th><th>Value</th></tr></thead><tbody>
        <tr><td>Plugin Class</td><td><code>{{ plugin.name }}</code></td></tr>
        <tr><td>Module</td><td><code>{{ plugin.module_path }}</code></td></tr>
        <tr><td>Version</td><td><code>{{ plugin.version }}</code></td></tr>
        <tr><td>Output Kind</td><td><code>{{ plugin.output_kind }}</code></td></tr>
      </tbody></table>
      <h3>Dependencies</h3>
      <table><thead><tr><th>Dependency</th><th>Version Constraint</th><th>Resolution</th><th>Required Fields</th><th>Description</th></tr></thead><tbody>
      {% if plugin.depends_on %}{% for dep in plugin.depends_on %}<tr><td><code>{{ dep if dep is string else dep[0] }}</code></td><td>{{ "-" if dep is string else dep[1] }}</td><td>declared</td><td>-</td><td>-</td></tr>{% endfor %}{% else %}<tr><td colspan="5">-</td></tr>{% endif %}
      </tbody></table>
    </section>
    <section><h2>Configuration</h2>
      <table><thead><tr><th>Name</th><th>Type</th><th>Default</th><th>Unit</th><th>Tracked</th><th>Deprecated</th><th>Description</th></tr></thead><tbody>
      {% if plugin.config_options %}{% for opt in plugin.config_options %}<tr><td><code>{{ opt.name }}</code></td><td><code>{{ opt.type }}</code></td><td><code>{{ opt.default }}</code></td><td>{{ opt.units or "-" }}</td><td>{{ "yes" if opt.tracked else "no" }}</td><td>{{ "yes" if opt.deprecated else "no" }}</td><td>{{ opt.doc or "-" }}</td></tr>{% endfor %}{% else %}<tr><td colspan="7">-</td></tr>{% endif %}
      </tbody></table>
    </section>
    <section><h2>Output</h2>
      <table><thead><tr><th>Field</th><th>DType</th><th>Unit</th><th>Meaning</th></tr></thead><tbody>
      {% if plugin.output_fields %}{% for field in plugin.output_fields %}<tr><td><code>{{ field.name }}</code></td><td><code>{{ field.dtype }}</code></td><td>{{ field.units or "-" }}</td><td>{{ field.doc or plugin.field_notes.get(field.name, "-") }}</td></tr>{% endfor %}{% else %}<tr><td>-</td><td><code>{{ plugin.output_kind }}</code></td><td>-</td><td>{{ plugin.description or "-" }}</td></tr>{% endif %}
      </tbody></table>
    </section>
    <section><h2>Usage</h2><pre><code>{% if plugin.usage_example %}{{ plugin.usage_example }}{% else %}ctx.get_data("run_001", "{{ plugin.provides }}"){% endif %}</code></pre></section>
  </main>
</body>
</html>
