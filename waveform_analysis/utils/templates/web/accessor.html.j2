{% extends "web/base.html.j2" %}
{% set page_title = accessor.name ~ " | WaveformAnalysis" %}
{% set asset_prefix = "../assets/" %}
{% set site_root_prefix = "../" %}
{% set body_class = "docs-page docs-detail" %}
{% set layout_class = "doc-layout" %}
{% set current = "accessors" %}
{% set active_accessor = accessor.slug %}
{% set site_home_href = "../index.html" %}
{% set plugin_index_href = "../plugins/index.html" %}
{% set accessor_index_href = "index.html" %}
{% block document %}
<main class="reference docs-main"><nav class="breadcrumbs" aria-label="面包屑"><a href="../index.html">文档概览</a><a href="index.html">Accessor</a><span aria-current="page">{{ accessor.name }}</span></nav><header class="page-heading"><p class="eyebrow">{{ accessor.module_path }}</p><h1>{{ accessor.name }}</h1><p>{{ accessor.summary }}</p></header><section id="overview"><h2>整体介绍</h2><p>{{ accessor.introduction | inline_code }}</p><h3>适用场景</h3><p>{{ accessor.purpose | inline_code }}</p></section><section id="constructor"><h2>构造器</h2><pre class="code-block"><code>{{ accessor.name }}{{ accessor.constructor_signature }}</code></pre>{% if accessor.constructor_parameters %}<div class="parameter-table"><table><thead><tr><th scope="col">参数</th><th scope="col">说明</th></tr></thead><tbody>{% for parameter in accessor.constructor_parameters %}<tr><td><code>{{ parameter.name }}</code></td><td>{{ parameter.description | inline_code }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}</section><section id="quickstart"><h2>快速开始</h2><pre class="code-block language-python"><code>{{ accessor.example_html }}</code></pre></section><section id="members"><h2>公开成员</h2><div class="member-list">{% for member in accessor.members %}<article class="member" id="{{ member.name }}"><p class="category">{{ "属性" if member.kind == "property" else "方法" }}</p><h3><code>{{ member.name }}</code></h3><pre class="member-signature"><code>{{ member.name }}{{ member.signature }}</code></pre><p>{{ member.description | inline_code }}</p>{% if member.parameters %}<h4>参数</h4><div class="parameter-table"><table><thead><tr><th scope="col">参数</th><th scope="col">说明</th></tr></thead><tbody>{% for parameter in member.parameters %}<tr><td><code>{{ parameter.name }}</code></td><td>{{ parameter.description | inline_code }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}{% if member.returns %}<h4>返回值</h4><p>{{ member.returns | inline_code }}</p>{% endif %}{% if member.notes %}<h4>使用注意</h4><ul class="member-notes">{% for note in member.notes %}<li>{{ note | inline_code }}</li>{% endfor %}</ul>{% endif %}{% if member.example_html %}<h4>示例</h4><pre class="code-block language-python"><code>{{ member.example_html }}</code></pre>{% endif %}</article>{% endfor %}</div></section></main><aside class="page-toc" aria-label="本页目录" data-page-toc><p>本文内容</p><ol></ol></aside>
{% endblock %}
