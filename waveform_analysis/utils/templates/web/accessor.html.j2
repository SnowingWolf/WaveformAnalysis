<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ accessor.name }} | WaveformAnalysis</title><link rel="stylesheet" href="../assets/site.css"><script defer src="../assets/site.js"></script></head>
<body><nav class="site-nav" aria-label="主导航"><a href="../index.html" class="site-brand">WaveformAnalysis 文档</a><a href="../plugins/index.html">插件系统</a><a href="index.html" aria-current="page">Accessor</a></nav>
<header class="plugin-header"><a href="index.html" class="back-link">返回 Accessor 索引</a><p class="eyebrow">{{ accessor.module_path }}</p><h1>{{ accessor.name }}</h1><p class="lede">{{ accessor.summary }}</p></header>
<div class="detail-layout"><aside class="page-location" aria-label="文档位置"><p class="category">全局位置</p><ol><li><a href="../index.html">文档总站</a></li><li><a href="../plugins/index.html">插件系统</a></li><li><a href="index.html">Accessor</a></li><li aria-current="page"><code>{{ accessor.name }}</code></li></ol><div class="page-location-links"><a href="index.html">所有 Accessor</a></div></aside><main class="reference"><section><h2>整体介绍</h2><p>{{ accessor.introduction | inline_code }}</p><h3>适用场景</h3><p>{{ accessor.purpose | inline_code }}</p></section>
<section><h2>构造器</h2><pre class="code-block"><code>{{ accessor.name }}{{ accessor.constructor_signature }}</code></pre>{% if accessor.constructor_parameters %}<div class="parameter-table"><table><thead><tr><th scope="col">参数</th><th scope="col">说明</th></tr></thead><tbody>{% for parameter in accessor.constructor_parameters %}<tr><td><code>{{ parameter.name }}</code></td><td>{{ parameter.description | inline_code }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}</section>
<section><h2>快速开始</h2><pre class="code-block language-python"><code>{{ accessor.example_html }}</code></pre></section>
<section><h2>公开成员</h2><div class="member-list">{% for member in accessor.members %}<article class="member" id="{{ member.name }}"><p class="category">{{ "属性" if member.kind == "property" else "方法" }}</p><h3><code>{{ member.name }}</code></h3><pre class="member-signature"><code>{{ member.name }}{{ member.signature }}</code></pre><p>{{ member.description | inline_code }}</p>{% if member.parameters %}<h4>参数</h4><div class="parameter-table"><table><thead><tr><th scope="col">参数</th><th scope="col">说明</th></tr></thead><tbody>{% for parameter in member.parameters %}<tr><td><code>{{ parameter.name }}</code></td><td>{{ parameter.description | inline_code }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}{% if member.returns %}<h4>返回值</h4><p>{{ member.returns | inline_code }}</p>{% endif %}{% if member.notes %}<h4>使用注意</h4><ul class="member-notes">{% for note in member.notes %}<li>{{ note | inline_code }}</li>{% endfor %}</ul>{% endif %}{% if member.example_html %}<h4>示例</h4><pre class="code-block language-python"><code>{{ member.example_html }}</code></pre>{% endif %}</article>{% endfor %}</div></section></main></div></body></html>
