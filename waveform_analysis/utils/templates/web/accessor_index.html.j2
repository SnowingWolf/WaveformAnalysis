{% block document %}
<main class="docs-main"><nav class="breadcrumbs" aria-label="面包屑"><a href="../index.html">文档概览</a><span aria-current="page">Accessor</span></nav><header class="page-heading"><p class="eyebrow">分析接口</p><h1>Accessor</h1><p>面向常见分析查询的只读便捷接口。</p></header><div class="resource-grid">{% for accessor in accessors %}<a class="resource-card" href="{{ accessor.slug }}.html"><span class="category">{{ accessor.name }}</span><h2>{{ accessor.name }}</h2><p>{{ accessor.summary }}</p><span class="card-link">阅读参考</span></a>{% endfor %}</div></main>
