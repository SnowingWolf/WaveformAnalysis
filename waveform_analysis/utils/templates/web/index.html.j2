{% import "web/shell.html.j2" as shell %}
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>WaveformAnalysis 插件参考</title><link rel="stylesheet" href="{{ asset_prefix }}site.css"><script src="{{ asset_prefix }}plotly.min.js"></script><script defer src="{{ asset_prefix }}site.js"></script></head>
<body class="site-index docs-page docs-plugin-index" data-site-root-prefix="{{ site_root_prefix }}">{{ shell.topbar(site_home_href, plugin_index_href, accessor_index_href, "plugins", asset_prefix) }}<div class="site-layout">{{ shell.navigation(site_home_href, plugin_index_href, accessor_index_href, "plugins") }}<main class="docs-main"><nav class="breadcrumbs" aria-label="面包屑"><a href="{{ site_home_href }}">文档概览</a><span aria-current="page">插件参考</span></nav><header class="page-heading page-heading-with-search"><div><p class="eyebrow">处理系统</p><h1>插件参考</h1><p>浏览内置插件、配置、输出字段和默认依赖谱系。</p></div><div><label class="search-label" for="plugin-search">筛选当前插件页</label><input id="plugin-search" type="search" placeholder="名称、类别或输出" autocomplete="off"></div></header>
<p id="search-status" class="status" aria-live="polite">共 {{ plugins|length }} 个插件</p>
<section class="lineage-section lineage-plotly-section"><div class="section-heading"><div><p class="eyebrow">默认依赖视图</p><h2>{{ lineage_graph.title }}</h2></div><p>拖动总览或使用滚轮缩放；选择节点可查看直接输入和消费者。</p></div><div class="lineage-view-controls" role="group" aria-label="谱系输出范围"><button type="button" class="lineage-view-control is-active" data-lineage-view="core" aria-pressed="true">Core</button><button type="button" class="lineage-view-control" data-lineage-view="all" aria-pressed="false">All outputs</button></div><div class="lineage-workspace" data-lineage-details="{{ asset_prefix }}lineage-details.json" data-lineage-overviews="{{ asset_prefix }}lineage-overviews.json" data-terminal-outputs="{{ terminal_outputs|join(',') }}" data-plugin-prefix="{{ plugin_href_prefix }}"><div class="lineage-overview"><div class="lineage-plotly">{{ global_lineage_html }}</div></div><aside class="lineage-detail" aria-live="polite"><div class="lineage-detail-header"><div><p class="eyebrow">直接谱系</p><h3 data-lineage-detail-title>选择一个插件</h3></div><button class="lineage-detail-close" type="button" title="关闭谱系详情" aria-label="关闭谱系详情" data-lineage-detail-close>关闭</button></div><p class="lineage-detail-empty" data-lineage-detail-empty>在总览中选择节点，查看它的直接输入和消费者。</p><a class="lineage-detail-link" data-lineage-detail-link hidden>打开插件参考</a><div class="lineage-detail-plot" data-lineage-detail-plot hidden></div></aside></div><p class="lineage-legend">Docs 表示文档完整度，Impact 表示默认解析图中的相对下游影响。</p>{% if lineage_graph.isolated_nodes %}<details class="lineage-isolated"><summary>默认配置下有 {{ lineage_graph.isolated_nodes|length }} 个孤立插件</summary><div class="lineage-isolated-list">{% for node in lineage_graph.isolated_nodes %}<a href="{{ node.href }}" title="{{ node.tooltip }}">{{ node.label }}</a>{% endfor %}</div></details>{% endif %}</section>
<div class="plugin-set-groups" id="plugin-grid">{% for plugin_set in plugin_sets %}<section class="plugin-set" data-plugin-set="{{ plugin_set.name }}"><div class="plugin-set-heading"><h2>{{ plugin_set.label }}</h2><p>{{ plugin_set.plugins|length }} 个插件</p></div><div class="plugin-grid">{% for plugin in plugin_set.plugins %}<a class="plugin-card" href="{{ plugin_href_prefix }}{{ plugin.provides }}.html" data-search="{{ plugin.provides }} {{ plugin.name }} {{ plugin.category }} {{ plugin.output_kind }} {{ plugin.summary }}"><span class="category">{{ plugin.category_display }}</span><h3>{{ plugin.provides }}</h3><p>{{ plugin.summary or "暂无说明。" }}</p><div class="metric-badges" aria-label="文档指标"><span class="metric-badge" title="文档完整度">Docs {{ plugin.documentation_completeness }}/100</span><span class="metric-badge" title="相对下游影响">Impact {{ plugin.dag_impact }}/100</span></div><dl><dt>输出</dt><dd>{{ plugin.output_kind }}</dd><dt>版本</dt><dd>{{ plugin.version }}</dd></dl></a>{% endfor %}</div></section>{% endfor %}</div>{% if standalone_plugins %}<section class="standalone-tools" data-plugin-set="standalone"><div class="plugin-set-heading"><div><p class="eyebrow">独立工具</p><h2>Standalone Tools</h2></div><p>{{ standalone_plugins|length }} 个工具</p></div><div class="plugin-grid">{% for plugin in standalone_plugins %}<a class="plugin-card" href="{{ plugin_href_prefix }}{{ plugin.provides }}.html" data-search="{{ plugin.provides }} {{ plugin.name }} {{ plugin.category }} {{ plugin.output_kind }} {{ plugin.summary }}"><span class="category">{{ plugin.category_display }}</span><h3>{{ plugin.provides }}</h3><p>{{ plugin.summary or "暂无说明。" }}</p><div class="metric-badges"><span class="metric-badge">Docs {{ plugin.documentation_completeness }}/100</span></div><dl><dt>输出</dt><dd>{{ plugin.output_kind }}</dd><dt>版本</dt><dd>{{ plugin.version }}</dd></dl></a>{% endfor %}</div></section>{% endif %}</main></div>{{ shell.footer() }}{% if lineage_details_json %}<script id="lineage-details-data" type="application/json">{{ lineage_details_json }}</script>{% endif %}{% if global_lineage_json %}<script id="lineage-overviews-data" type="application/json">{{ global_lineage_json }}</script>{% endif %}{{ shell.search_dialog(asset_prefix) }}</body></html>
