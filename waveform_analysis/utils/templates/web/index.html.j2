{% extends "web/base.html.j2" %}
{% set page_title = "WaveformAnalysis 插件参考" %}
{% set body_class = "site-index docs-page docs-plugin-index docs-page--lineage" %}
{% set layout_class = "site-layout" %}
{% set current = "plugins" %}
{% set load_lineage = true %}
{% set accessor_detail_prefix = "../accessors/" %}
{% block document %}
<main class="docs-main docs-main--wide"><nav class="breadcrumbs" aria-label="面包屑"><a href="{{ site_home_href }}">文档概览</a><span aria-current="page">插件参考</span></nav><header class="page-heading page-heading-with-search"><div><p class="eyebrow">处理系统</p><h1>插件参考</h1><p>浏览内置插件、配置、输出字段和默认依赖谱系。</p></div><div><label class="search-label" for="plugin-search">筛选当前插件页</label><input id="plugin-search" type="search" placeholder="名称、类别或输出" autocomplete="off"></div></header>
<p id="search-status" class="status" aria-live="polite">共 {{ plugins|length }} 个插件</p>
<section class="lineage-entry"><div><p class="eyebrow">数据血缘</p><h2>插件 DAG</h2><p>查看从原始输入到事件产物的默认处理链、全部输出和局部上下游。</p></div><a class="button-link" href="{{ lineage_href }}">独立查看</a></section><section class="lineage-section" data-react-lineage></section>
<div class="plugin-set-groups" id="plugin-grid">{% for plugin_set in plugin_sets %}<section class="plugin-set" data-plugin-set="{{ plugin_set.name }}"><div class="plugin-set-heading"><h2>{{ plugin_set.label }}</h2><p>{{ plugin_set.plugins|length }} 个插件</p></div>{% if plugin_set.description %}<p class="plugin-set-description">{{ plugin_set.description }}</p>{% endif %}<div class="plugin-grid">{% for plugin in plugin_set.plugins %}<a class="plugin-card" href="{{ plugin_href_prefix }}{{ plugin.provides }}.html" data-search="{{ plugin.provides }} {{ plugin.name }} {{ plugin.category }} {{ plugin.output_kind }} {{ plugin.summary }}"><span class="category">{{ plugin.category_display }}</span><h3>{{ plugin.provides }}</h3><p>{{ plugin.summary or "暂无说明。" }}</p><div class="metric-badges" aria-label="文档指标"><span class="metric-badge" title="文档完整度">Docs {{ plugin.documentation_completeness }}/100</span><span class="metric-badge" title="相对下游影响">Impact {{ plugin.dag_impact }}/100</span></div><dl><dt>输出</dt><dd>{{ plugin.output_kind }}</dd><dt>版本</dt><dd>{{ plugin.version }}</dd></dl></a>{% endfor %}</div></section>{% endfor %}</div>{% if standalone_plugins %}<section class="standalone-tools" data-plugin-set="standalone"><div class="plugin-set-heading"><div><p class="eyebrow">独立工具</p><h2>Standalone Tools</h2></div><p>{{ standalone_plugins|length }} 个工具</p></div><div class="plugin-grid">{% for plugin in standalone_plugins %}<a class="plugin-card" href="{{ plugin_href_prefix }}{{ plugin.provides }}.html" data-search="{{ plugin.provides }} {{ plugin.name }} {{ plugin.category }} {{ plugin.output_kind }} {{ plugin.summary }}"><span class="category">{{ plugin.category_display }}</span><h3>{{ plugin.provides }}</h3><p>{{ plugin.summary or "暂无说明。" }}</p><div class="metric-badges"><span class="metric-badge">Docs {{ plugin.documentation_completeness }}/100</span></div><dl><dt>输出</dt><dd>{{ plugin.output_kind }}</dd><dt>版本</dt><dd>{{ plugin.version }}</dd></dl></a>{% endfor %}</div></section>{% endif %}</main>
{% endblock %}
{% block after_shell %}<script id="lineage-graph-data" type="application/json">{{ global_lineage_json }}</script>{% endblock %}
