<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>WaveformAnalysis Plugin Reference</title>
  <link rel="stylesheet" href="assets/site.css">
  <script src="assets/plotly.min.js"></script>
  <script defer src="assets/site.js"></script>
</head>
<body>
  <header class="site-header">
    <div>
      <p class="eyebrow">WaveformAnalysis</p>
      <h1>Plugin Reference</h1>
    </div>
    <label class="search-label" for="plugin-search">Search plugins</label>
    <input id="plugin-search" type="search" placeholder="Name, category, output..." autocomplete="off">
  </header>
  <main>
    <p id="search-status" class="status" aria-live="polite">{{ plugins|length }} plugins</p>
    <section class="lineage-section lineage-plotly-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Default dependency view</p>
          <h2>{{ lineage_graph.title }}</h2>
        </div>
        <p>Dependencies resolved from builtin plugin defaults. Drag to pan, use the mode bar or mouse wheel to zoom, and select a plugin to inspect its direct port-level lineage.</p>
      </div>
      <div class="lineage-workspace" data-lineage-details="assets/lineage-details.json">
        <div class="lineage-overview">
          <div class="lineage-plotly">{{ global_lineage_html }}</div>
        </div>
        <aside class="lineage-detail" aria-live="polite">
          <div class="lineage-detail-header">
            <div>
              <p class="eyebrow">Direct lineage</p>
              <h3 data-lineage-detail-title>Select a plugin</h3>
            </div>
            <button class="lineage-detail-close" type="button" title="Close lineage detail" aria-label="Close lineage detail" data-lineage-detail-close>&times;</button>
          </div>
          <p class="lineage-detail-empty" data-lineage-detail-empty>Select a node in the overview to inspect its direct inputs and consumers.</p>
          <a class="lineage-detail-link" data-lineage-detail-link hidden>Open plugin reference</a>
          <div class="lineage-detail-plot" data-lineage-detail-plot hidden></div>
        </aside>
      </div>
      <p class="lineage-legend">Docs: documentation completeness. Impact: relative downstream reach in the default-resolved plugin graph. No run data or cache is accessed.</p>
      {% if lineage_graph.isolated_nodes %}
      <details class="lineage-isolated">
        <summary>{{ lineage_graph.isolated_nodes|length }} isolated plugins (under defaults)</summary>
        <div class="lineage-isolated-list">
          {% for node in lineage_graph.isolated_nodes %}<a href="{{ node.href }}" title="{{ node.tooltip }}">{{ node.label }}</a>{% endfor %}
        </div>
      </details>
      {% endif %}
    </section>
    <div class="plugin-grid" id="plugin-grid">
    {% for plugin in plugins %}
      <a class="plugin-card" href="plugins/{{ plugin.provides }}.html"
         data-search="{{ plugin.provides }} {{ plugin.name }} {{ plugin.category }} {{ plugin.output_kind }} {{ plugin.summary }}">
        <span class="category">{{ plugin.category_display }}</span>
        <h2>{{ plugin.provides }}</h2>
        <p>{{ plugin.summary or "No description available." }}</p>
        <div class="metric-badges" aria-label="Documentation metrics">
          <span class="metric-badge" title="Documentation completeness">Docs {{ plugin.documentation_completeness }}/100</span>
          <span class="metric-badge" title="Relative downstream impact">Impact {{ plugin.dag_impact }}/100</span>
        </div>
        <dl><dt>Output</dt><dd>{{ plugin.output_kind }}</dd><dt>Version</dt><dd>{{ plugin.version }}</dd></dl>
      </a>
    {% endfor %}
    </div>
  </main>
</body>
</html>
