<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>WaveformAnalysis Plugin Reference</title>
  <link rel="stylesheet" href="assets/site.css">
  <script defer src="assets/site.js"></script>
</head>
<body>
  <header class="site-header">
    <div>
      <p class="eyebrow">WaveformAnalysis</p>
      <h1>Plugin Reference</h1>
    </div>
    <label class="search-label" for="plugin-search">Search plugins</label>
    <input id="plugin-search" type="search" placeholder="Name, category, output..." autocomplete="off">
  </header>
  <main>
    <p id="search-status" class="status" aria-live="polite">{{ plugins|length }} plugins</p>
    <div class="plugin-grid" id="plugin-grid">
    {% for plugin in plugins %}
      <a class="plugin-card" href="plugins/{{ plugin.provides }}.html"
         data-search="{{ plugin.provides }} {{ plugin.name }} {{ plugin.category }} {{ plugin.output_kind }} {{ plugin.summary }}">
        <span class="category">{{ plugin.category_display }}</span>
        <h2>{{ plugin.provides }}</h2>
        <p>{{ plugin.summary or "No description available." }}</p>
        <dl><dt>Output</dt><dd>{{ plugin.output_kind }}</dd><dt>Version</dt><dd>{{ plugin.version }}</dd></dl>
      </a>
    {% endfor %}
    </div>
  </main>
</body>
</html>
