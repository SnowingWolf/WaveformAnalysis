{% extends "web/base.html.j2" %}
{% import "web/content_block.html.j2" as content %}
{% set page_title = page.title ~ " | WaveformAnalysis" %}
{% set asset_prefix = "../assets/" %}
{% set site_root_prefix = "../" %}
{% set body_class = "docs-page docs-detail" %}
{% set layout_class = "doc-layout" %}
{% set current = current_section %}
{% set load_mermaid = page.has_mermaid %}
{% set active_accessor = "records-view" if page.slug == "records-view" else none %}
{% set current_guide_route = current_section ~ "/" ~ page.slug ~ ".html" %}
{% set site_home_href = "../index.html" %}
{% set plugin_index_href = "../plugins/index.html" %}
{% set accessor_index_href = "../accessors/index.html" %}
{% set accessor_detail_prefix = "../accessors/" %}
{% set context_index_href = "../contexts/context.html" %}
{% set adapter_index_href = "../adapters/adapter.html" %}
{% set visualization_index_href = "../visualizations/index.html" %}
{% set visualization_detail_prefix = "../visualizations/" %}
{% block document %}
<main class="reference docs-main"><nav class="breadcrumbs" aria-label="面包屑"><a href="../index.html">文档概览</a><a href="index.html">{{ index_title }}</a><span aria-current="page">{{ page.title }}</span></nav><header class="page-heading"><p class="eyebrow">{{ page.eyebrow }}</p><h1>{{ page.title }}</h1><p>{{ page.summary }}</p>{% if related_guide_href %}<p><a class="inline-reference-link" href="{{ related_guide_href }}">{{ related_guide_label }}</a></p>{% endif %}</header><section id="overview"><h2>整体介绍</h2><p>{{ page.introduction | inline_code }}</p></section>{% for section in page.narrative_sections %}<section id="{{ section.anchor }}"><h2>{{ section.title }}</h2>{% for block in section.blocks %}{{ content.render(block, asset_prefix) }}{% endfor %}</section>{% endfor %}{% for group, members in page.groups %}<section id="{{ group.anchor }}"><h2>{{ group.title }}</h2><p>{{ group.description | inline_code }}</p><div class="member-list">{% for member in members %}<article class="member" id="{{ member.name }}"><p class="category">{{ "构造器" if member.kind == "class" else "函数" }}</p><h3><code>{{ member.name }}</code></h3><pre class="code-block member-signature language-python"><code>{{ member.signature_html }}</code></pre><p>{{ member.description | inline_code }}</p>{% if member.parameters %}<h4>参数</h4><div class="parameter-table"><table><thead><tr><th scope="col">参数</th><th scope="col">说明</th></tr></thead><tbody>{% for parameter in member.parameters %}<tr><td><code>{{ parameter.name }}</code></td><td>{{ parameter.description | inline_code }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}{% if member.returns %}<h4>返回值</h4><p>{{ member.returns | inline_code }}</p>{% endif %}{% if member.notes %}<h4>使用注意</h4><ul class="member-notes">{% for note in member.notes %}<li>{{ note | inline_code }}</li>{% endfor %}</ul>{% endif %}{% if member.example_html %}<h4>示例</h4><pre class="code-block language-python"><code>{{ member.example_html }}</code></pre>{% endif %}</article>{% endfor %}</div></section>{% endfor %}</main>
{% endblock %}
