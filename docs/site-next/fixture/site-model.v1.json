  "plugins": [
    {
      "provides": "raw_files",
      "pluginClass": "RawFileNamesPlugin",
      "version": "0.0.2",
      "executionKind": "static",
      "outputKind": "raw_data",
      "category": "I/O",
      "summary": "扫描 DAQ 原始文件并建立运行输入。",
      "dependsOn": [],
      "config": [],
      "fields": [],
      "usage": "ctx.get_data(run_id, \"raw_files\")",
      "route": "/plugins/raw_files/",
      "provenance": "fixture"
    },
    {
      "provides": "records",
      "pluginClass": "RecordsPlugin",
      "version": "0.14.2",
      "executionKind": "static",
      "outputKind": "structured_array",
      "category": "记录处理",
      "summary": "将 DAQ 原始文件转换为结构化 records，并保存波形索引。",
      "dependsOn": [
        "raw_files"
      ],
      "config": [
        {
          "name": "daq_adapter",
          "value": "vx2730",
          "description": "DAQ 适配器名称。"
        },
        {
          "name": "input_source",
          "value": "raw_files",
          "description": "records bundle 输入源。"
        },
        {
          "name": "dt",
          "value": "None",
          "description": "采样间隔，缺省取适配器语义。"
        },
        {
          "name": "keep_on_disk",
          "value": "true",
          "description": "是否保持 bundle 磁盘驻留。"
        }
      ],
      "fields": [
        {
          "name": "timestamp",
          "dtype": "int64",
          "unit": "ps",
          "description": "ADC 事件时间戳。"
        },
        {
          "name": "pid",
          "dtype": "int32",
          "unit": "—",
          "description": "分区标识，用于稳定排序。"
        },
        {
          "name": "board",
          "dtype": "int16",
          "unit": "—",
          "description": "硬件板卡编号。"
        },
        {
          "name": "channel",
          "dtype": "int16",
          "unit": "—",
          "description": "板内物理通道编号。"
        },
        {
          "name": "baseline",
          "dtype": "float64",
          "unit": "ADC",
          "description": "全局波形基线。"
        },
        {
          "name": "baseline_upstream",
          "dtype": "float64",
          "unit": "ADC",
          "description": "上游提供的基线。"
        },
        {
          "name": "polarity",
          "dtype": "<U8",
          "unit": "—",
          "description": "硬件真实信号极性。"
        },
        {
          "name": "record_id",
          "dtype": "int64",
          "unit": "—",
          "description": "排序后的稳定记录编号。"
        },
        {
          "name": "dt",
          "dtype": "int32",
          "unit": "ns",
          "description": "样本间隔。"
        },
        {
          "name": "trigger_type",
          "dtype": "int16",
          "unit": "—",
          "description": "触发类型编码。"
        },
        {
          "name": "flags",
          "dtype": "uint32",
          "unit": "—",
          "description": "记录标志位。"
        },
        {
          "name": "wave_offset",
          "dtype": "int64",
          "unit": "—",
          "description": "wave_pool 起始索引。"
        },
        {
          "name": "event_length",
          "dtype": "int32",
          "unit": "samples",
          "description": "波形样本长度。"
        },
        {
          "name": "time",
          "dtype": "int64",
          "unit": "ns",
          "description": "系统时间，可选语义。"
        }
      ],
      "usage": "from waveform_analysis import Context\nfrom waveform_analysis.plugins import profiles\n\nctx = Context(config={\"data_root\": \"DAQ\", \"daq_adapter\": \"vx2730\"})\nctx.register(*profiles.cpu_default())\nresult = ctx.get_data(\"run_001\", \"records\")",
      "route": "/plugins/records/",
      "provenance": "fixture"
    },
