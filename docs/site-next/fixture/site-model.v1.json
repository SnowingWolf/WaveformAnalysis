      "provenance": "fixture",
      "sections": [
        {
          "id": "workflow",
          "title": "最小示例",
          "paragraphs": [
            "先建立 Context、注册 profile，再请求 records 或更高层产物。"
          ],
          "code": "from waveform_analysis import Context\nfrom waveform_analysis.plugins import profiles\n\nctx = Context(config={\"data_root\": \"DAQ\", \"daq_adapter\": \"vx2730\"})\nctx.register(*profiles.cpu_default())\nrecords = ctx.get_data(\"run_001\", \"records\")"
        }
      ]
    },
    {
